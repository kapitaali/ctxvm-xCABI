# so it is local harness state, never repo content.
.opencode/

# Capture-task artifacts written when tools/w5-owner-run runs from the repo root.
/notes/

# build output (npm package emit; never commit — rebuilt by `npm run build`/prepack)
dist/
packages/py/build/
packages/py/ctxvm_py.egg-info/

# Uncommitted research sources (2026-11-05): two independent safety-research notes
# were written by different models and the owner asked for the SYNTHESIS to be the
# committed record, not the sources. They stay on disk under this folder, tracked
# by name in research/synthesis-20261105.md, never by git.
research/uncommitted/

# Disposable paste artefact regenerated per run by tools/session-start.sh
# (review fix 6, 2026-11-08): untracked noise that can carry packet content.
handoff/SESSION-START.md

# Benchmark workspace (redline-16k). Condition B keeps the benchmark OUTSIDE this repo;
