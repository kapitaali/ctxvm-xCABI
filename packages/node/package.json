{
  "name": "@ctxvm/node",
  "version": "0.1.0",
  "description": "Telemetry-first tracer for agent loops — RFC-0 xCABI JSONL in TypeScript, zero runtime dependencies.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kapitaali/ctxvm-xCABI.git",
    "directory": "packages/node"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --test test/",
    "gen": "node test/generate.ts",
    "validate": "../../venvs/odps/bin/python ../../spec/rfc-0/validate_schema.py fixtures/tracer-healthy.jsonl fixtures/tracer-recall.jsonl",
    "replay": "cd ../.. && cargo run --quiet --release -p ctxvm-conformance --bin replay"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  }
}
